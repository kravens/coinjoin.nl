import { Theme, UISize } from "@ui/theme.slint";
import { CjButton } from "../../cjbutton.slint";
import { CjStepper } from "../../cjstepper.slint";
import { Card } from "@ui/card.slint";
import { SlideToConfirm } from "@ui/slide_to_confirm.slint";
import { Navigate } from "../../gen/navigate.slint";
import { Cj } from "../../cj.slint";

export component AuthorizePage inherits Rectangle {
    background: Theme.palette-background;
    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 24px + UISize.control-center-status-bar-height;
        padding-bottom: 24px;
        spacing: 12px;
        Text {
            text: "Authorize coinjoin?";
            color: Theme.palette-foreground;
            font-family: "Montserrat";
            font-size: 22px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        CjStepper { current: 1; }
        // Every line below is the policy the engine will enforce, not an example:
        // the same struct that gates each round is what gets rendered here.
        Card {
            width: 100%;
            vertical-stretch: 0;
            size: lg;
            eyebrow: "Coordinator";
            title: Cj.coordinator;
            body: "Account #" + Cj.account + " (" + Cj.network + ")\n"
                + "Fee budget: " + Cj.fee-budget + " sat total\n"
                + "Rounds: up to " + Cj.max-rounds + "\n"
                + "Valid for: " + Cj.valid-for + "\n"
                + "Outputs: your wallet only";
            footer: "Then rounds sign automatically.";
        }
        Text {
            text: "The fee budget is for the whole session, not per round.";
            color: Theme.palette-muted;
            font-family: "Montserrat";
            font-size: 12px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Rectangle { vertical-stretch: 1; }
        Text {
            visible: Cj.status != "";
            text: Cj.status;
            color: Theme.palette-secondary;
            font-family: "Montserrat";
            font-size: 12px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        CjButton {
            width: 100%;
            secondary: true;
            text: "Deny";
            clicked => { Navigate.backward(); }
        }
        SlideToConfirm {
            width: 100%;
            vertical-stretch: 0;
            control-height: 64px;
            label: "Slide";
            hint: "Slide to authorize";
            confirmed-label: "Authorized";
            thumb-color: Theme.palette-primary;
            track-color: Theme.palette-surface;
            track-border-color: Theme.palette-border;
            // Only advance if the engine really opened a session; a denied seed
            // permission or a refused policy leaves the user here with a reason.
            activated => {
                if (Cj.authorize()) {
                    Navigate.session({ });
                }
            }
        }
    }
}
