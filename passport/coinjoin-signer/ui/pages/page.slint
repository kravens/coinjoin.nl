import { Theme, UISize } from "@ui/theme.slint";
import { CjButton } from "../cjbutton.slint";
import { CjStepper } from "../cjstepper.slint";
import { Card } from "@ui/card.slint";
import { Chip, ChipColor } from "@ui/chip.slint";
import { Navigate } from "../gen/navigate.slint";
import { Cj } from "../cj.slint";

export component MainPagePage inherits Rectangle {
    background: Theme.palette-background;
    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 24px + UISize.control-center-status-bar-height;
        padding-bottom: 24px;
        spacing: 16px;
        Text {
            text: "Coinjoin Signer";
            color: Theme.palette-foreground;
            font-family: "Montserrat";
            font-size: 24px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            Chip { text: "Waiting for Wasabi"; color: ChipColor.secondary; }
        }
        CjStepper { current: 0; }
        Card {
            width: 100%;
            vertical-stretch: 0;
            size: lg;
            eyebrow: "WabiSabi remote signer";
            title: "No active session";
            body: "Start a coinjoin in Wasabi Wallet. You approve one policy here; rounds are then signed without further taps.";
            footer: "Your keys never leave the device.";
        }
        Text {
            text: "No host transport yet — KeyOS does not give apps a USB or QuantumLink channel. The request below is local; everything after it is the real engine.";
            color: Theme.palette-muted;
            font-family: "Montserrat";
            font-size: 12px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Rectangle { vertical-stretch: 1; }
        Text {
            visible: Cj.status != "";
            text: Cj.status;
            color: Theme.palette-secondary;
            font-family: "Montserrat";
            font-size: 12px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        CjButton {
            width: 100%;
            text: "Simulate incoming request";
            clicked => { Cj.request-demo(); Navigate.authorize({ }); }
        }
    }
}
